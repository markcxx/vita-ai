{
  "name": "@lt-employ-assistant/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev --turbopack",
    "build": "node --use-env-proxy node_modules/next/dist/bin/next build",
    "start": "node --use-env-proxy .next/standalone/frontend/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "build:renderer": "esbuild scripts/render-resume.tsx --bundle --platform=node --format=cjs --external:puppeteer-core --outfile=dist/resume-renderer.cjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.80",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "ai": "^6.0.78",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-cloud": "^1.2.9",
    "docx": "9.7.1",
    "lucide-react": "^0.563.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "puppeteer-core": "24.43.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-cloud": "^1.2.9",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.2.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
