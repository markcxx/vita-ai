{
  "name": "lt-employ-assistant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @lt-employ-assistant/web dev",
    "dev:api": "pnpm --dir frontend build:renderer && uv run --directory backend uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "pnpm --filter @lt-employ-assistant/web build",
    "start:web": "pnpm --filter @lt-employ-assistant/web start",
    "lint": "pnpm --filter @lt-employ-assistant/web lint",
    "test": "pnpm --filter @lt-employ-assistant/web test",
    "test:api": "uv run --directory backend pytest",
    "type-check": "pnpm --filter @lt-employ-assistant/web type-check",
    "check:api": "uv run --directory backend ruff check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "sharp",
      "unrs-resolver",
      "esbuild",
      "@parcel/watcher"
    ],
    "overrides": {
      "basic-ftp": "5.3.1",
      "socks": "2.8.9"
    }
  }
}
