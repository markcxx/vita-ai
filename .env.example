# Copy to the repository root .env. Process environment overrides this file.
# Do not use NEXT_PUBLIC_ for database or model credentials.
APP_NAME=VitaAI
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
APP_CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL: the database must exist; first startup creates application tables.
# URL-encode special characters in the username and password.
DATABASE_URL=postgresql://user:password@localhost:5432/vita_ai

AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o
AI_API_KEY=
AI_THINKING_MODE=auto

DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_WEBSOCKET_URL=
DASHSCOPE_TTS_MODEL=qwen-audio-3.0-tts-flash
DASHSCOPE_TTS_VOICE=

# Optional: run integration tests in a disposable schema within this PostgreSQL database.
# TEST_DATABASE_URL=postgresql://test_user:password@localhost:5432/vita_ai_test

# Better Auth: generate a new secret per deployment. Keep APP_URL identical to the browser origin.
APP_URL=http://localhost:3000
AUTH_SERVER_URL=http://127.0.0.1:3000
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# GitHub callback: http://localhost:3000/api/auth/callback/github
SMTP_HOST=
SMTP_PORT_SSL=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TIMEOUT_SECONDS=20
EMAIL_VERIFICATION_TTL_SECONDS=600
AUTH_EMAIL_HOURLY_LIMIT=100
# AI_API_KEY/DASHSCOPE_API_KEY are for offline development scripts only.
# Web requests always require each user's own browser-local credentials.
# In production users enter model Base URL/model/key and voice key in browser settings.
